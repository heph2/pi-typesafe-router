{
  "name": "pi-typesafe-router",
  "version": "0.1.0",
  "description": "Route Pi agent turns to an appropriate model using TypeSafe judgments.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "files": [
