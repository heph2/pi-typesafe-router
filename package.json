  },
  "keywords": [
    "pi-package",
    "pi",
    "typesafe",
    "model-routing"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
